{
  "name": "tinky-vision-mcp",
  "version": "0.2.0",
  "description": "MCP bridge for controlling legacy macOS apps via vision + accessibility. Lets Claude Desktop / Claude Code / any MCP client see + click + type in any app that doesn't natively speak MCP.",
  "type": "module",
  "bin": {
    "tinky-vision-mcp": "./src/server.mjs"
  },
  "scripts": {
    "build:helper": "cd swift-helper && swift build -c release && cp .build/release/tinky-os ../bin/tinky-os",
    "build:scoped-helper": "node scripts/stage-scoped-helper.mjs",
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.1",
    "hono": "4.12.32"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "author": "Luke Kist / TinkyBink",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgewellEPM/tinky-vision-mcp.git"
  },
  "homepage": "https://github.com/AgewellEPM/tinky-vision-mcp",
  "bugs": {
    "url": "https://github.com/AgewellEPM/tinky-vision-mcp/issues"
  }
}
